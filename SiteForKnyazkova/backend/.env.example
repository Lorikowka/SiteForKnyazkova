# ═══════════════════════════════════════════════════════════
# ШАБЛОН ПЕРЕМЕННЫХ ОКРУЖЕНИЯ
# ═══════════════════════════════════════════════════════════
# Этот файл МОЖНО коммитить в Git
# Скопируй в .env.development или .env.production и заполни

# ───────────────────────────────────────────────────────────
# СЕРВЕР
# ───────────────────────────────────────────────────────────
PORT=1234
NODE_ENV=development

# ───────────────────────────────────────────────────────────
# URL САЙТА
# ───────────────────────────────────────────────────────────
SITE_URL=https://lorikowka.github.io/

# ───────────────────────────────────────────────────────────
# ЮKASSA (ТЕСТОВЫЙ РЕЖИМ)
# ───────────────────────────────────────────────────────────
# Получить в личном кабинете yookassa.ru
YOOKASSA_SHOP_ID=1317355
YOOKASSA_SECRET_KEY=test_EUrRjW-hHvY0jmF3swUfUDWMFAl9GJAp3-6OVEKCtsM

# Режим: test или production
PAYMENT_MODE=test

# ───────────────────────────────────────────────────────────
# TELEGRAM (УВЕДОМЛЕНИЯ)
# ───────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ───────────────────────────────────────────────────────────
# EMAIL (SMTP) — УВЕДОМЛЕНИЯ КЛИЕНТАМ
# ───────────────────────────────────────────────────────────
# Gmail пример:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com

# ───────────────────────────────────────────────────────────
# БЕЗОПАСНОСТЬ
# ───────────────────────────────────────────────────────────
# Ключ для проверки HMAC подписи webhook (предоставляется ЮKassa)
# Настраивается в личном кабинете ЮKassa при создании webhook
# Для генерации: openssl rand -hex 32
YOOKASSA_WEBHOOK_SECRET=webhook_test_secret

# ───────────────────────────────────────────────────────────
# RATE LIMITING
# ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ───────────────────────────────────────────────────────────
# ЛОГИРОВАНИЕ
# ───────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# ───────────────────────────────────────────────────────────
# CORS (для production)
# ───────────────────────────────────────────────────────────
# ALLOWED_ORIGINS=https://psixolog-site.ru

# ───────────────────────────────────────────────────────────
# API КЛЮЧ (для админ-эндпоинтов /api/sessions, /api/payments)
# ───────────────────────────────────────────────────────────
# Генерация: openssl rand -hex 32
# Должен совпадать с API_KEY в telegram-bot/.env
API_KEY=your_secret_api_key_here
