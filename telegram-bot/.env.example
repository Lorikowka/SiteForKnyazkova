# ───────────────────────────────────────────────────────────
# Telegram-бот (админ-панель)
# Скопируйте в .env:  copy .env.example .env
# ───────────────────────────────────────────────────────────

# Токен бота, полученный у @BotFather.
TELEGRAM_BOT_TOKEN=

# Ваш личный Telegram ID (узнать у @userinfobot) — даёт доступ к админ-командам.
# Если не задан, бот попробует использовать TELEGRAM_CHAT_ID.
TELEGRAM_ADMIN_ID=

# ID чата/канала для уведомлений о новых записях.
TELEGRAM_CHAT_ID=

# Адрес работающего backend.
BACKEND_URL=http://localhost:1488

# Ключ доступа бота к защищённым эндпоинтам.
# Должен совпадать с BOT_API_KEYS (или API_KEY) в конфигурации backend.
BOT_API_KEY=

# Прокси для запросов к Telegram API (необязательно), например socks5://127.0.0.1:1080
TELEGRAM_PROXY=

# Напоминания и утренние сводки.
REMINDERS_ENABLED=true
MORNING_SUMMARY_ENABLED=true
MORNING_SUMMARY_HOUR=8
