# Telegram Bot Token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Ваш Telegram ID (узнать у @userinfobot)
TELEGRAM_ADMIN_ID=0

# URL backend API
BACKEND_URL=http://localhost:1488

# API Key для авторизации бота (должен совпадать с API_KEY на бэкенде)
API_KEY=your_api_key_here

# For a separated backend bot key, set this to one of backend BOT_API_KEYS.
BOT_API_KEY=your_bot_api_key_here

# Optional Telegram proxy. Examples:
# TELEGRAM_PROXY=http://127.0.0.1:7890
# TELEGRAM_PROXY=socks5://127.0.0.1:1080
TELEGRAM_PROXY=

# Optional background jobs
REMINDERS_ENABLED=true
MORNING_SUMMARY_ENABLED=true
MORNING_SUMMARY_HOUR=8
