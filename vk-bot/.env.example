# VK group id without minus sign.
VK_GROUP_ID=123456789

# Comma-separated VK user ids allowed to use admin commands.
# If empty, access is open to every user who writes to the bot.
VK_ADMIN_IDS=123456789

# Backend API URL.
BACKEND_URL=http://localhost:1488

# Bot API key. Must match one of backend BOT_API_KEYS or API_KEY.
BOT_API_KEY=your_bot_api_key_here

# Optional background jobs.
REMINDERS_ENABLED=true
MORNING_SUMMARY_ENABLED=true
MORNING_SUMMARY_HOUR=8

# Poll backend and send VK notifications about new bookings/payments/status changes.
EVENT_WATCHER_ENABLED=true
EVENT_POLL_INTERVAL_SECONDS=30
