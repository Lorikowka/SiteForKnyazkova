# ───────────────────────────────────────────────────────────
# VK-бот (админ-панель)
# Скопируйте в .env:  copy .env.example .env
# ───────────────────────────────────────────────────────────

# Токен сообщества ВК с правом на сообщения.
VK_BOT_TOKEN=

# ID сообщества (только цифры, без минуса).
VK_GROUP_ID=

# ID администраторов через запятую.
VK_ADMIN_IDS=

# Адрес backend.
BACKEND_URL=http://localhost:1488

# Ключ доступа бота к защищённым эндпоинтам.
# Должен совпадать с BOT_API_KEYS (или API_KEY) в конфигурации backend.
BOT_API_KEY=

# Напоминания и утренние сводки.
REMINDERS_ENABLED=false
MORNING_SUMMARY_ENABLED=false
MORNING_SUMMARY_HOUR=8

# Если true — Python-бот сам опрашивает backend и отправляет уведомления
# о новых записях. В этом случае оставьте VK_BOT_TOKEN в backend пустым,
# чтобы уведомления не дублировались.
EVENT_WATCHER_ENABLED=false
EVENT_POLL_INTERVAL_SECONDS=30

# Отключить проверку SSL-сертификатов (только при CERTIFICATE_VERIFY_FAILED).
DISABLE_SSL_VERIFY=false
