# ═══════════════════════════════════════════════════════════
# LOCAL DEVELOPMENT
# ═══════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────
# СЕРВЕР
# ───────────────────────────────────────────────────────────
PORT=1488
NODE_ENV=development

# ───────────────────────────────────────────────────────────
# URL САЙТА — localhost (без туннеля)
# ───────────────────────────────────────────────────────────
SITE_URL=http://localhost:1488

# ───────────────────────────────────────────────────────────
# ЮKASSA (ТЕСТОВЫЙ РЕЖИМ)
# ───────────────────────────────────────────────────────────
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# ───────────────────────────────────────────────────────────
# MOCK РЕЖИМ — отключён, используем реальную оплату
# ───────────────────────────────────────────────────────────
MOCK_MODE=false

# ───────────────────────────────────────────────────────────
# TELEGRAM (УВЕДОМЛЕНИЯ И АДМИН-БОТ)
# ───────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Числовой ID администратора (ваш личный Telegram user id) для доступа к админ-командам.
# Если не задан, бот попробует использовать TELEGRAM_CHAT_ID.
TELEGRAM_ADMIN_ID=
# ID чата/канала для уведомлений о новых записях.
TELEGRAM_CHAT_ID=
VK_BOT_TOKEN=
VK_NOTIFY_PEER_IDS=
VK_API_VERSION=5.199

# ───────────────────────────────────────────────────────────
# VK БОТ (АДМИН-ПАНЕЛЬ)
# ───────────────────────────────────────────────────────────
# ID вашего сообщества VK (только цифры, без минуса).
VK_GROUP_ID=
# ID администраторов через запятую для доступа к командам бота.
VK_ADMIN_IDS=
# Адрес запущенного backend-сервера для бота.
BACKEND_URL=http://localhost:1488
# Ключ для доступа бота к защищенным эндпоинтам API.
# Должен совпадать с одним из ключей в BOT_API_KEYS в .env бэкенда.
BOT_API_KEY=
# Отключить проверку SSL-сертификатов (для обхода ошибок в некоторых сетях).
# Установите в 'true' только если вы получаете ошибку CERTIFICATE_VERIFY_FAILED.
DISABLE_SSL_VERIFY=false
# Отправлять напоминания клиентам.
REMINDERS_ENABLED=false
# Ежедневная утренняя сводка администратору.
MORNING_SUMMARY_ENABLED=false
MORNING_SUMMARY_HOUR=8
# Python-бот сам опрашивает backend и отправляет уведомления о новых записях.
EVENT_WATCHER_ENABLED=false
EVENT_POLL_INTERVAL_SECONDS=30


# ───────────────────────────────────────────────────────────
# EMAIL (SMTP)
# ───────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ───────────────────────────────────────────────────────────
# БЕЗОПАСНОСТЬ
# ───────────────────────────────────────────────────────────
# Вебхуки проверяются запросом к API ЮKassa с YOOKASSA_SECRET_KEY.

# ───────────────────────────────────────────────────────────
# ALLOWED ORIGINS для CORS
# ───────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:1488,http://127.0.0.1:1488,http://localhost:5500,http://127.0.0.1:5500,https://lorikowka.github.io,https://psy-knyazkova.ru

# ───────────────────────────────────────────────────────────
# API КЛЮЧИ (для защищённых эндпоинтов)
# ───────────────────────────────────────────────────────────
# Общий ключ-фолбэк для админ- и бот-эндпоинтов.
API_KEY=
# Ключи для админ-эндпоинтов (через запятую). Если пусто — используется API_KEY.
ADMIN_API_KEYS=
# Ключи для эндпоинтов ботов (через запятую). Если пусто — используется API_KEY / BOT_API_KEY.
BOT_API_KEYS=